{
  "name": "middag",
  "author": {
    "name": "Alexander Czigler",
    "url": "https://github.com/alexanderczigler/"
  },
  "license": "ISC",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "format": "prettier --write .",
    "generate": "node ./scripts/generateRecipeTypes.js",
    "lint": "prettier --check . && eslint .",
    "preview": "vite preview",
    "smoke-test": "npm run lint && npm run build && npm run test",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.10",
    "@types/json-schema": "7.0.15",
    "@types/node": "26.6.6",
    "autoprefixer": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "keywords": [
    "meal planner",
    "recipe collection",
    "shopping list generator"
  ],
  "dependencies": {
    "@fontsource/nunito": "5.3.0"
  },
  "overrides": {
    "eslint": "9.39.2"
  }
}
